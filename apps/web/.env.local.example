# OBSIDIAN RIDES - copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored. NEVER commit real keys.

# Supabase authentication and data access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Canonical origin used in confirmation and password-recovery callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Server-only. Never expose to the browser or prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# AI services.
ANTHROPIC_API_KEY=

# Server-only voice provider configuration. Use an original licensed voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
