# OBSIDIAN RIDES — copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored. NEVER commit real keys.

# --- Supabase (needed from M2 onward; M1 boots without live values) ---
# From your Supabase project: Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the browser, never prefix with NEXT_PUBLIC.
# Used later for privileged server tasks (e.g. migrations/admin), not for
# normal tenant-scoped access (which goes through RLS + the anon key).
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (needed from M7 — Ask OBSIDIAN) ---
ANTHROPIC_API_KEY=
