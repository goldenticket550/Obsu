# OBSIDIAN — Environment variable template (Phase 0)
# Copy to .env.local and fill in. NEVER commit real values.
# These are placeholders documenting the intended surface, not active integrations yet.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Database / Supabase (Phase 1) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # server-only, never expose to client
DATABASE_URL=

# --- AI (Phase 1) ---
ANTHROPIC_API_KEY=
# Future multi-model routing keys go here as needed.

# --- Billing / Stripe (Phase 8 / commercial) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- Voice / ElevenLabs (Phase 3) ---
ELEVENLABS_API_KEY=

# --- Messaging / SMS (Phase 5) ---
SMS_PROVIDER_API_KEY=

